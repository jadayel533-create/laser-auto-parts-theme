<article class="product-card">
  <a class="product-image" href="{{ url_for('product_details', slug=product.slug) }}" aria-label="{{ product.name }}">
    {% if product.main_image and product.main_image.image and product.main_image.image.large %}
      <img src="{{ image_url(product.main_image.image.large, w=600, q=82, f='auto') }}" alt="{{ product.name }}" loading="lazy" decoding="async">
    {% elif product.images and product.images[0] and product.images[0].image and product.images[0].image.full_size %}
      <img src="{{ image_url(product.images[0].image.full_size, w=600, q=82, f='auto') }}" alt="{{ product.name }}" loading="lazy" decoding="async">
    {% elif product.thumbnail %}
      <img src="{{ image_url(product.thumbnail, w=600, q=82, f='auto') }}" alt="{{ product.name }}" loading="lazy" decoding="async">
    {% else %}
      <span class="product-image-placeholder" aria-hidden="true">{{ _('Auto part') }}</span>
    {% endif %}
    {% if product.badge %}
      <span class="product-badge">{{ product.badge.body }}</span>
    {% elif product.discount_percentage %}
      <span class="product-badge">-{{ product.discount_percentage }}%</span>
    {% endif %}
  </a>
  <div class="product-body">
    {% if product.brand %}<span class="product-brand">{{ product.brand.name }}</span>{% endif %}
    <h3><a href="{{ url_for('product_details', slug=product.slug) }}">{{ product.name }}</a></h3>
    {% if product.formatted_sale_price %}
      <div class="product-price"><strong>{{ product.formatted_sale_price }}</strong> <del>{{ product.formatted_price }}</del></div>
    {% elif product.formatted_price %}
      <strong class="product-price">{{ product.formatted_price }}</strong>
    {% elif product.price %}
      <strong class="product-price">{{ product.price }} {{ _('SAR') }}</strong>
    {% endif %}
    <a class="btn btn-primary btn-full" href="{{ url_for('product_details', slug=product.slug) }}">{{ _('View product') }}</a>
  </div>
</article>
