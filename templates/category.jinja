{% extends "layout.jinja" %}
{% block title %}{{ category.name }} – {{ store.name }}{% endblock %}
{% block content %}
<section class="section category-page" aria-labelledby="category-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ store.name }}</p>
        <h1 id="category-title">{{ category.name }}</h1>
        {% if category.description %}<p>{{ category.description }}</p>{% endif %}
      </div>
      <a class="btn" href="{{ url_for('list_products') }}">{{ _('All products') }}</a>
    </div>

    {% if category.sub_categories %}
      <div class="category-subgrid">
        {% for sub in category.sub_categories %}
          <a class="category-card" href="{{ url_for('category_details', category_id=sub.id, slug=sub.slug) }}">
            <span>{{ sub.name }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if products.filters and products.filters | length > 0 %}
      <div class="catalog-filters">
        {% include 'vitrin:products/filters.jinja' %}
      </div>
    {% endif %}

    {% set product_list = products.results if products is defined and products.results else [] %}
    {% if product_list %}
      <div class="product-grid">
        {% for product in product_list %}
          {% include 'components/product-card.jinja' %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <h2>{{ _('No products found') }}</h2>
        <p>{{ _('There are no products in this category yet.') }}</p>
      </div>
    {% endif %}

    {% if products.pages_count and products.pages_count > 1 %}
      <nav class="pagination" aria-label="{{ _('Pagination') }}">
        {% if products.page > 1 %}
          <a class="btn" href="{{ session.url.include_query_params(page=products.page - 1) }}">{{ _('Previous') }}</a>
        {% endif %}
        <span>{{ products.page }} / {{ products.pages_count }}</span>
        {% if products.page < products.pages_count %}
          <a class="btn" href="{{ session.url.include_query_params(page=products.page + 1) }}">{{ _('Next') }}</a>
        {% endif %}
      </nav>
    {% endif %}
  </div>
</section>
{% endblock %}
