{% from 'components/section-heading.jinja' import render as section_heading %}
{% set product_list = products.results if products is defined and products.results else [] %}
{% if product_list %}
<section class="section featured-products" aria-labelledby="featured-products-title">
  <div class="container">
    {{ section_heading(_('Recommended'), section.settings.title | default(_('Featured products')), section.settings.subtitle | default(_('Quality parts selected for your vehicle.')), url_for('list_products'), _('View all products')) }}
    <div class="product-grid">
      {% for product in product_list[:8] %}
        {% include 'components/product-card.jinja' %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
