<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <strong>{{ store.name }}</strong>
      {% if store.settings.branding.description %}
        <p>{{ store.settings.branding.description }}</p>
      {% endif %}
    </div>
    {% set contact = store.settings.contact if store.settings is defined and store.settings.contact is defined else {} %}
    {% if contact.phone or contact.email %}
      <div class="footer-contact" aria-label="{{ _('Contact') }}">
        {% if contact.phone %}<a href="tel:{{ contact.phone }}">{{ contact.phone }}</a>{% endif %}
        {% if contact.email %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
</footer>
